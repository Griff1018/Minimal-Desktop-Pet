{
  "name": "desktop-pet-todo",
  "version": "1.0.0",
  "description": "桌宠待办事项",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "author": "desktop-pet",
  "build": {
    "appId": "com.local.desktoppettodo",
    "productName": "桌宠待办",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "assets/pet",
        "to": "pet"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true
    }
  }
}